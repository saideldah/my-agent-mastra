GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
GOOGLE_API_KEY=your-google-api-key

# Weather Email Agent configuration
WEATHER_CITY=San Francisco
RECIPIENT_EMAIL=user@example.com
# Optional: set RESEND_API_KEY (and EMAIL_FROM) to send real emails instead of simulated console emails
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Weather Agent <onboarding@resend.dev>
# Demo login credentials. Tokens expire after one hour.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-password
